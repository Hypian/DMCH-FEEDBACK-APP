NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# In production, set FRONTEND_ORIGIN to https://hypian.github.io
DMC_DEVICE_HASH_SECRET=generate-an-independent-random-secret-at-least-32-characters-long
HOST=127.0.0.1
PORT=5173

# ─── AI Sentiment & Urgency Analysis ─────────────────────────────────
# Privacy Note: Inputs sent to the free tier of the Gemini API may be used
# by Google to train and improve its products. Patient feedback may include
# sensitive health or personal details. Setting REDACT_BEFORE_LLM=true masks
# phone numbers, emails, and long numeric sequences before sending to the LLM.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
REDACT_BEFORE_LLM=true

# ─── Alerting Engine (InTouch SMS & Nodemailer Email) ─────────────────
# Dry-run mode: logs simulated payload and records outbox rows without making external API/SMTP calls.
# Set to false in production to enable live SMS & email delivery.
ALERTS_DRY_RUN=true

# InTouch SMS (Rwanda) Credentials (https://portal.intouchsms.co.rw)
# Dispatches direct SMS ONLY for negative feedback requiring immediate attention (Critical & High severity)
INTOUCH_SMS_USERNAME=dreammedical.hospital
INTOUCH_SMS_PASSWORD=dreammedical.hospital
INTOUCH_SMS_SENDER=DMCHOSPITAL
SMS_PROVIDER=intouch

# Nodemailer SMTP Configuration
# Dispatches email alerts for normal negative feedback (no immediate clinical harm)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@dmchospital.org
SMTP_PASS=your-smtp-or-app-password
SMTP_SECURE=false
EMAIL_FROM="DMC Hospital Feedback Alerts" <alerts@dmchospital.org>

# Fallback Routing if no department contact matches
ALERT_FALLBACK_PHONE=+250788000000
ALERT_FALLBACK_EMAIL=duty-manager@dmchospital.org

# Escalation timers (in minutes) for unacknowledged alerts to be escalated to Duty Manager
ESCALATE_CRITICAL_MINUTES=15
ESCALATE_HIGH_MINUTES=60

# Secret token required to invoke the /api/cron/process-alerts endpoint on serverless environments
CRON_SECRET=generate-a-secure-random-token-for-cron-triggers

# Strict Privacy Protection: SMS and Email messages must NEVER contain patient text, names, or IDs.
ALERT_INCLUDE_EXCERPT=false
