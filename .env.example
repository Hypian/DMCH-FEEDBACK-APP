NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# In production, set FRONTEND_ORIGIN to https://hypian.github.io
DMC_DEVICE_HASH_SECRET=generate-an-independent-random-secret-at-least-32-characters-long
HOST=127.0.0.1
PORT=5173

# ─── AI Sentiment & Urgency Analysis ─────────────────────────────────
# Privacy Note: Inputs sent to the free tier of the Gemini API may be used
# by Google to train and improve its products. Patient feedback may include
# sensitive health or personal details. Setting REDACT_BEFORE_LLM=true masks
# phone numbers, emails, and long numeric sequences before sending to the LLM.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
REDACT_BEFORE_LLM=true

# ─── Urgent Alert Notification Hook ──────────────────────────────────
# Optional endpoint (Slack, Microsoft Teams, SMS gateway, or internal webhook)
# called immediately whenever an urgent feedback submission is flagged.
URGENT_ALERT_WEBHOOK_URL=

# ─── WhatsApp Business Alerts (Meta Cloud API) ─────────────────────────
# Master switch to activate the WhatsApp notification engine (default: false)
ALERTS_ENABLED=false

# Dry-run mode: logs simulated payload and records outbox rows without calling Meta API.
# Shipped ON by default for safe local development and staging verification.
ALERTS_DRY_RUN=true

# Meta WhatsApp Cloud API credentials (obtain from developers.facebook.com)
WA_PHONE_NUMBER_ID=your-meta-phone-number-id
WA_ACCESS_TOKEN=your-meta-system-user-access-token
WA_APP_SECRET=your-meta-app-secret
WA_VERIFY_TOKEN=your-custom-webhook-verify-token-string
WA_API_VERSION=v21.0

# Fallback phone (E.164 format, e.g. Rwanda +250...) if no department contact matches
ALERT_FALLBACK_PHONE=+250788000000

# Escalation timers (in minutes) for unacknowledged alerts to be escalated to Duty Manager
ESCALATE_CRITICAL_MINUTES=15
ESCALATE_HIGH_MINUTES=60

# Secret token required to invoke the /api/cron/process-alerts endpoint on serverless environments
CRON_SECRET=generate-a-secure-random-token-for-cron-triggers

# Strict Privacy Protection: WhatsApp messages must NEVER contain patient text, names, or IDs.
# Setting this to true is strongly discouraged and restricted by hospital privacy policies.
ALERT_INCLUDE_EXCERPT=false

# Optional Africa's Talking SMS Fallback (triggers only for Critical alerts after 5 WhatsApp failures)
AFRICASTALKING_SMS_FALLBACK_ENABLED=false
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
